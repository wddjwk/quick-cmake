# C++ standard
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Suppress warnings (match CMake -w flag)
build --cxxopt=-w

# Use C++ toolchain
build --action_env=CC
build --action_env=CXX

# Show test output on failure
test --test_output=errors

# ─── GCC/MinGW toolchain on Windows ───
# Usage: bazel build --config=gcc //target
build:gcc --extra_toolchains=//toolchains/gcc:gcc_toolchain
build:gcc --action_env=PATH
