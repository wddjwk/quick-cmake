module(
    name = "quick-cmake",
    version = "0.1.0",
)

# ─── Bazel rules ───
bazel_dep(name = "rules_cc", version = "0.2.17")

# ─── Testing & benchmarking ───
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")

# ─── Logging ───
bazel_dep(name = "spdlog", version = "1.17.0")

# ─── JSON ───
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")

# ─── HTTP client ───
bazel_dep(name = "curl", version = "8.12.0")

# ─── Boost (split modules on BCR) ───
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.graph", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.interprocess", version = "1.90.0.bcr.1")

# ─── Standalone Asio (for coro examples) ───
bazel_dep(name = "asio", version = "1.34.2.bcr.1")

# ─── io_uring (Linux async IO) ───
bazel_dep(name = "liburing", version = "2.14")

# ─── Non-BCR dependencies (concurrencpp) ───
non_module_deps = use_extension("//:extensions.bzl", "non_module_deps")
use_repo(non_module_deps, "concurrencpp")

# ─── GCC/MinGW toolchain (for --config=gcc on Windows) ───
gcc_toolchain_ext = use_extension("//toolchains/gcc:extensions.bzl", "gcc_toolchain")
use_repo(gcc_toolchain_ext, "gcc_toolchain")

# NOTE: protobuf and tbb are used as system libraries (not managed by Bazel).
#       See //third_party/protobuf and //third_party/tbb.
