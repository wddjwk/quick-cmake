    deps = [
        "@googletest//:gtest_main",
        "@googletest//:gtest",
    ],
)

cc_binary(
    name = "demo_benchmark",
    srcs = ["demo_benchmark.cpp"],
    deps = ["@google_benchmark//:benchmark_main"],
)
