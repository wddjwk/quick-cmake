load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "demo_gtest",
    srcs = ["demo_gtest.cpp"],
    deps = [
        "//include:dbg",
        "//include:skutils",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "demo_gmock",
